# ============================================================
# Docker ignore — minimize build context for CI / Linux wheel
# ============================================================

# Git
.git/
.gitignore
.gitattributes

# Rust build cache
/target

# Python
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/
dist/
build/

# IDE
.idea/
.vscode/

# Claude Code
.claude/
localsession

# Reference projects
tdxpy/

# Docs — not needed for build
docs/dev/
docs/del/
docs/WORK_LOG_*.md

# Tests, examples, tools — not needed for wheel
# 注意: benches/ 不能排除 —— Cargo.toml 显式声明 [[bench]] reader_bench，
# cargo 解析 manifest 需要文件在构建上下文中存在，缺席则整个构建报错
tests/
examples/
tools/

# Example outputs
examples/*.png

# OS
.DS_Store
Thumbs.db
